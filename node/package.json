{
  "name": "decoyshield",
  "version": "0.8.0",
  "description": "Counter-recon honeypot for Node.js against agentic LLM attackers — invisible-to-human, visible-to-LLM payloads for Express, Fastify, and any Node HTTP server. Sibling to the Python `decoyshield` package.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "honeypot",
    "prompt-injection",
    "prompt-injection-defense",
    "llm-security",
    "ai-security",
    "agentic-ai",
    "express",
    "express-middleware",
    "fastify",
    "fastify-plugin",
    "middleware",
    "decoyshield",
    "pentest",
    "defense"
  ],
  "author": "DecoyShield contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lunayue0917-max/DecoyShield.git",
    "directory": "node"
  },
  "homepage": "https://github.com/lunayue0917-max/DecoyShield/tree/main/node#readme",
  "bugs": "https://github.com/lunayue0917-max/DecoyShield/issues",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "express": "^4.18.2",
    "fastify": "^4.26.0",
    "supertest": "^6.3.4",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "peerDependencies": {
    "express": ">=4.0.0",
    "fastify": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  }
}
